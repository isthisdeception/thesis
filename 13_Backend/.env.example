# 13_Backend/.env.example
# Copy to .env for local overrides. Never commit real secrets (.env is gitignored).

DJANGO_ENV=dev
DJANGO_SECRET_KEY=replace-with-env-secret-key-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Forensic system paths (relative to repo root or absolute)
FORENSIC_MEDIA_ROOT=13_Backend/media/cases
FORENSIC_LOG_DIR=13_Backend/media/logs
FORENSIC_EVIDENCE_REGISTRY=11_AI_Forensic_System/evidence_registry.csv
FORENSIC_CASE_REGISTRY=11_AI_Forensic_System/case_registry.csv
FORENSIC_MODEL_ID=MODEL0001
FORENSIC_ARTIFACT_ROOT=
FORENSIC_ASYNC_MODE=thread
FORENSIC_MEDIA_RETENTION_DAYS=30

# Security & rate limits
FORENSIC_MAX_UPLOAD_BYTES=20971520
FORENSIC_THROTTLE_UPLOAD=30/min
FORENSIC_THROTTLE_ANON=240/min
