        </mxCell>
        <mxCell id="4" value="&lt;b&gt;M2: Image Validation&lt;/b&gt;&lt;br/&gt;Decode, RGB, Noise,&lt;br/&gt;Single-Face Gate" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontSize=11;fontStyle=0;fillColor=#FFFFFF;strokeColor=#2C3E50;fontColor=#1C2833;strokeWidth=1.4;" vertex="1" parent="1">
          <mxGeometry x="285" y="78" width="275" height="90" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;b&gt;Early Validation Stops&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;unsupported_format&lt;br/&gt;corrupted_image&lt;br/&gt;no_face | multiple_faces&lt;br/&gt;&lt;br/&gt;&lt;i&gt;Halt before collectors;&lt;br/&gt;omit verdict; log failed case&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontSize=10;fontStyle=0;fillColor=#FDEDEC;strokeColor=#922B21;fontColor=#641E16;strokeWidth=1.4;" vertex="1" parent="1">
          <mxGeometry x="40" y="218" width="175" height="195" as="geometry" />
        </mxCell>
        <mxCell id="6" value="&lt;b&gt;M3: 9 Independent Signal Collectors&lt;/b&gt;&lt;br/&gt;Metadata | Image Statistics | Face Detection&lt;br/&gt;Face Quality | Frequency (FFT) | Compression&lt;br/&gt;Color Distribution | Texture | XAI Input&lt;br/&gt;&lt;i&gt;(Zero inter-collector coupling)&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontSize=10;fontStyle=0;fillColor=#FFFFFF;strokeColor=#2C3E50;fontColor=#1C2833;strokeWidth=1.4;" vertex="1" parent="1">
