        </mxCell>
        <mxCell id="7" value="&lt;b&gt;M4: Deep Learning Specialist&lt;/b&gt;&lt;br/&gt;ResNet-50 Detector — Emits P(fake) only&lt;br/&gt;&lt;i&gt;(Isolated specialist; never decides)&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontSize=11;fontStyle=0;fillColor=#FEF5E7;strokeColor=#B9770E;fontColor=#7E5109;strokeWidth=1.4;" vertex="1" parent="1">
          <mxGeometry x="285" y="330" width="275" height="83" as="geometry" />
        </mxCell>
