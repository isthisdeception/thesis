        <mxCell id="2" value="TRUST BOUNDARY A: Image-Reading Layer (Isolated Collectors, Zero Decision Authority)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=6;spacingLeft=10;fontFamily=Helvetica;fontSize=12;fontStyle=1;fillColor=#EBF3F9;strokeColor=#1F618D;fontColor=#154360;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="20" y="30" width="560" height="405" as="geometry" />
        </mxCell>
        <mxCell id="3" value="&lt;b&gt;M1: Input Intake&lt;/b&gt;&lt;br/&gt;Format &amp;amp; Size (&amp;lt;=20 MB)&lt;br/&gt;SHA-256 + Metadata" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontSize=11;fontStyle=0;fillColor=#FFFFFF;strokeColor=#2C3E50;fontColor=#1C2833;strokeWidth=1.4;" vertex="1" parent="1">
