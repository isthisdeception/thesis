        <mxCell id="5" value="&lt;b&gt;Centralized API Client (src/api/)&lt;/b&gt;&lt;br/&gt;forensicApi.js | http.js | errors.js&lt;br/&gt;Env Base URL + Dev Proxy&lt;br/&gt;&lt;i&gt;Zero direct fetch() outside src/api/&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontSize=11;fontStyle=0;fillColor=#FEF5E7;strokeColor=#B9770E;fontColor=#7E5109;strokeWidth=1.4;" vertex="1" parent="1">
