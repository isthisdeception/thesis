        <mxCell id="8" value="&lt;b&gt;REST API Router (10 Canonical Endpoints)&lt;/b&gt;&lt;br/&gt;POST /cases | GET /cases/{id} | POST /upload&lt;br/&gt;GET /status, /evidence, /decision, /explanation, /report&lt;br/&gt;GET /health | GET /version (mounted at / and /api/v1/)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontSize=10;fontStyle=0;fillColor=#FFFFFF;strokeColor=#2C3E50;fontColor=#1C2833;strokeWidth=1.4;" vertex="1" parent="1">
