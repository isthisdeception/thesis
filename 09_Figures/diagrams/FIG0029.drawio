        <mxCell id="4" value="&lt;b&gt;Scoped Client State&lt;/b&gt;&lt;br/&gt;SystemContext (/health, /version)&lt;br/&gt;ThemeContext (light/dark + alerts)&lt;br/&gt;useInvestigation(caseId) Polling Hook" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;fontSize=11;fontStyle=0;fillColor=#FFFFFF;strokeColor=#2C3E50;fontColor=#1C2833;strokeWidth=1.4;" vertex="1" parent="1">
