        <mxCell id="2" value="Tier 1: React Frontend Presentation Layer" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=6;spacingLeft=10;fontFamily=Helvetica;fontSize=12;fontStyle=1;fillColor=#EBF3F9;strokeColor=#1F618D;fontColor=#154360;strokeWidth=1.5;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
